# ==============================================================================
# Autonomous 24/7 E-Paper News Agent - Environment Configuration
# Copy this file to .env and populate your free API keys.
# ==============================================================================

# --- LLM API Keys (100% Free Tiers) ---
# Primary LLM: Google Gemini API (gemini-3.8-flash, gemini-3.5-flash-lite)
# Obtain free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Secondary LLM Fallback: Groq Cloud API (llama-3.3-70b-versatile)
# Obtain free key at: https://console.groq.com/keys
GROQ_API_KEY=

# --- Distribution Channels ---
# Telegram Bot API (Delivers E-Paper PDF + Highlights)
# 1. Talk to @BotFather on Telegram to create bot and get token
TELEGRAM_BOT_TOKEN=
# 2. Talk to @userinfobot or @raw_data_bot to get your numerical chat ID
TELEGRAM_CHAT_ID=

# --- Optional Email Distribution (Gmail SMTP) ---
# Your Gmail address for sending editions
GMAIL_USER=
# 16-character App Password generated via https://myaccount.google.com/security
GMAIL_APP_PASSWORD=
# Destination email addresses (comma-separated, optional - defaults to GMAIL_USER)
GMAIL_RECIPIENTS=

# --- Pipeline Configuration (Optional Defaults) ---
LOG_LEVEL=INFO
ROLLING_WINDOW_HOURS=26
DEDUPLICATION_THRESHOLD=0.80
BATCH_SIZE=15
